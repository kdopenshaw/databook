      "id": "sales",
      "label": "Sales",
      "order": 1,
      "rows": [
        {
          "id": "md-sales",
          "type": "markdown",
          "order": 0,
          "createdBy": "skill",
          "body": "## Mix and ticket shape\n\nDrinks dominate, but food carries weekends. Merch is thin and spiky. Ticket sizes cluster under $10 with a long right tail from beans and mugs.\n"
        },
        {
          "id": "comp-mix",
          "type": "component",
          "order": 1,
          "createdBy": "skill",
          "components": [
            {
              "id": "category-mix",
              "title": "Category mix by month",
              "subtitle": "Stacked revenue · Drink / Food / Merch",
              "component": "CategoryMix",
              "query": {
                "groupBy": [
                  "month",
                  "category"
                ],
                "aggregate": [
                  {
                    "fn": "sum",
                    "column": "amount",
                    "as": "revenue"
                  }
                ],
                "orderBy": [
                  {
                    "column": "month",
                    "direction": "asc"
                  },
                  {
                    "column": "category",
                    "direction": "asc"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "comp-hist",
          "type": "component",
          "order": 2,
          "createdBy": "skill",
          "components": [
            {
              "id": "ticket-hist",
              "title": "Line-item amount distribution",
              "subtitle": "$2 bins · count of line items",
              "component": "TicketSizeHist",
              "query": {
                "bin": [
                  {
                    "column": "amount",
                    "step": 2,
                    "as": "amount_bin"
                  }
                ],
                "aggregate": [
                  {
                    "fn": "count",
                    "as": "n"
                  }
                ],
                "orderBy": [
                  {
                    "column": "amount_bin",
                    "direction": "asc"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "experience",
