              "title": "Revenue by cafe",
              "subtitle": "H1 total · ranked",
              "component": "RevenueByCafe",
              "query": {
                "groupBy": [
                  "cafe"
                ],
                "aggregate": [
                  {
                    "fn": "sum",
                    "column": "amount",
                    "as": "revenue"
                  }
