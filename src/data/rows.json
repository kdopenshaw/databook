          "type": "markdown",
          "order": 0,
          "createdBy": "skill",
          "body": "## Wait, rating, membership\n\nScatter is a 400-row sample of tickets. Longer waits sit with lower ratings — especially Food. Member share rose \\~several points across H1.\n"
        },
        {
          "id": "comp-scatter",
          "type": "component",
          "order": 1,
          "createdBy": "skill",
          "components": [
            {
              "id": "wait-rating",
              "title": "Wait vs rating",
              "subtitle": "Sample of tickets · color = cafe",
              "component": "WaitVsRating",
              "query": {
                "sample": {
                  "n": 400,
                  "seed": 7
                },
                "orderBy": [
                  {
                    "column": "wait_min",
                    "direction": "asc"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "comp-member",
          "type": "component",
          "order": 2,
          "createdBy": "skill",
          "components": [
            {
              "id": "member-share",
              "title": "Member share of tickets",
              "subtitle": "Share of line items with is_member",
              "component": "MemberShare",
              "query": {
                "groupBy": [
                  "month"
                ],
                "aggregate": [
                  {
                    "fn": "share",
                    "column": "is_member",
                    "as": "member_share"
                  }
                ],
                "orderBy": [
                  {
                    "column": "month",
                    "direction": "asc"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
