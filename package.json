{
  "name": "databook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ok": "node scripts/ok-book.mjs",
    "validate": "npm run ok",
    "print-block": "node scripts/print-block.mjs",
    "lint:charts": "vitest run src/data/chartLint.test.ts",
    "check": "npm run ok",
    "check:visual": "node scripts/check-book.mjs --visual",
    "smoke:insert": "node scripts/smoke-markdown-insert.mjs",
    "extend-check": "node scripts/ok-book.mjs --artifacts-only"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
