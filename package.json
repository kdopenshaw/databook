{
  "name": "databook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ok": "node scripts/ok-book.mjs",
    "validate": "npm run ok",
    "print-block": "node scripts/print-block.mjs",
    "check": "npm run ok",
    "check:visual": "node scripts/check-book.mjs --visual",
    "smoke:insert": "node scripts/smoke-markdown-insert.mjs",
    "extend-check": "node scripts/ok-book.mjs --artifacts-only"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.5.0",
    "@mdxeditor/floating-selection-ui-plugin": "^1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
