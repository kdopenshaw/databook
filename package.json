{
  "name": "databook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ok": "node scripts/ok-book.mjs",
    "validate": "npm run ok",
    "print-block": "node scripts/print-block.mjs",
    "snap": "node scripts/snap-charts.mjs",
    "check": "npm run ok",
    "check:visual": "node scripts/check-book.mjs --visual",
    "smoke:insert": "node scripts/smoke-markdown-insert.mjs",
    "extend-check": "node scripts/ok-book.mjs --artifacts-only",
    "rows-to-md": "node scripts/rows-to-markdown.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "^1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
